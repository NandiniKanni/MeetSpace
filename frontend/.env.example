# Copy this file to ".env" and change the values to match YOUR backend.
# Vite only exposes variables that start with VITE_ to the browser.
# Never put database passwords or secrets in here - everything in this file is visible to users.

# Base URL of your Express server (no trailing slash)
VITE_API_URL=http://localhost:8000

# The path where users.routes.js is mounted in backend/src/app.js
# (look for a line like: app.use("/api/v1/users", userRoutes))
VITE_API_USERS_PATH=/api/v1/users

# Where Socket.IO is served from (usually the same server as the API)
VITE_SOCKET_URL=http://localhost:8000

# Optional: product name shown in the UI
VITE_APP_NAME=MeetSpace
